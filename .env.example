# ========================================================
# ดอกเตอร์ลอว์เยอร์ (Doctor Lawyer) — Environment Configuration
# ========================================================
# Copy this file to .env and adjust values for your environment.

# ----------------- Server Settings -----------------
HOST=127.0.0.1
PORT=3000
PYTHONUTF8=1

# ----------------- Quota & Tiers -----------------
# Free AI requests quota for registered members
FREE_AI_QUOTA_LIMIT=3

# ----------------- Partner Lawyer (LINE OA) -----------------
LINE_OA_ID=@doctorlawyer
LINE_OA_URL=https://line.me/R/ti/p/@doctorlawyer

# ----------------- LINE LIFF Integration -----------------
LINE_LIFF_ID=2011732178-nMl0LXMq
LINE_CHANNEL_ID=2011732178

# ----------------- Low-Cost LLM Providers (Tier 2 AI Router) -----------------
# 1. Google Gemini API (Recommended: ultra-low cost / free tier)
GEMINI_API_KEY=

# 2. OpenAI API (e.g. gpt-4o-mini)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# 3. Custom / OpenAI-Compatible API (e.g. DeepSeek, Groq, OpenRouter, Ollama)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1

# ----------------- Email Verification (SMTP) -----------------
# If left blank, the server will operate in Demo Mode and display OTP on console & UI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Doctor Lawyer <no-reply@doctorlawyer.ai>

# ----------------- Google Sign-In (OAuth) -----------------
# Optional: Google Identity Services Client ID
GOOGLE_CLIENT_ID=
