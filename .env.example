# ========================================================
# ดอกเตอร์ลอว์เยอร์ (Doctor Lawyer) — Environment Configuration
# ========================================================
# Copy this file to .env and adjust values for your environment.

# ----------------- Server Settings -----------------
HOST=127.0.0.1
PORT=3000
PYTHONUTF8=1

# ----------------- Quota & Tiers -----------------
# Free AI requests quota for registered members
FREE_AI_QUOTA_LIMIT=3

# ----------------- Partner Lawyer (LINE OA) -----------------
LINE_OA_ID=@doctorlawyer
LINE_OA_URL=https://lin.ee/NQLCu3p

# ----------------- LINE LIFF Integration -----------------
LINE_LIFF_ID=2012301635-WMe8TR6J
LINE_LIFF_URL=https://liff.line.me/2012301635-WMe8TR6J
LINE_CHANNEL_ID=2012301635
LINE_CHANNEL_SECRET=82b5a8addcad17c5555adf9ec429a281

# ----------------- Low-Cost LLM Providers (Tier 2 AI Router) -----------------
# 1. Google Gemini API (Recommended: Free tier 15 RPM / 1,500 RPD)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq Cloud (Free Tier: Fast inference & OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# 3. OpenAI API (e.g. gpt-4o-mini)
OPENAI_API_KEY=

# ----------------- Email Verification (SMTP) -----------------
# If left blank, the server will operate in Demo Mode and display OTP on console & UI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Doctor Lawyer <no-reply@doctorlawyer.ai>

# ----------------- Google Sign-In (OAuth) -----------------
# Optional: Google Identity Services Client ID
GOOGLE_CLIENT_ID=
